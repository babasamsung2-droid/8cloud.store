rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (request.auth.token.email != null && 
         request.auth.token.email.lower() == 'babasamsung2@gmail.com' && 
         request.auth.token.email_verified == true)
      );
    }

    function validNewUserProfile(userId) {
      return isOwner(userId) &&
        incoming().keys().hasOnly(['id', 'name', 'email', 'avatarUrl', 'authProvider', 'createdAt', 'updatedAt']) &&
        incoming().id == request.auth.uid &&
        incoming().email == request.auth.token.email;
    }

    function validUserProfileUpdate(userId) {
      return isOwner(userId) &&
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'avatarUrl', 'authProvider', 'updatedAt']) &&
        incoming().id == request.auth.uid &&
        incoming().email == request.auth.token.email;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read, write: if isAdmin();
    }

    // Users collection
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if validNewUserProfile(userId);
      allow update: if validUserProfileUpdate(userId);
      allow delete: if isAdmin();

      // Orders are written only by the trusted payment backend.
      match /orders/{orderId} {
        allow get, list: if isOwner(userId) || isAdmin();
        allow create, update, delete: if false;
      }
    }
  }
}

# Default remains a non-selling demo. Configure the server first.
VITE_STORE_MODE=demo
VITE_ENABLE_CHECKOUT=false
VITE_CHECKOUT_API_URL=
# Gateway public key is returned by the authenticated server. No key/secret needed here.

# Optional: switch the frontend to your selected Firebase project as one complete set.
# Copy all four from Firebase Project Settings > Your apps. Do not mix projects.
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIRESTORE_DATABASE_ID=
VITE_FIRESTORE_PROFILES_ENABLED=false

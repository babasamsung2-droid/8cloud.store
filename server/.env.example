FIRESTORE_DATABASE_ID=(default)
PRIVATE_STORAGE_BUCKET=
STOREFRONT_ORIGIN=https://www.8cloud.store
PAYMENT_MODE=test
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
